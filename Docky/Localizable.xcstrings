    "Hide Trash" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрыть Корзину"
          }
        }
      }
    },
    "Hides Finder and Trash tiles so the dock reads as a clean shelf of pinned apps and widgets." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oculta los íconos de Finder y Papelera para que el dock se vea como una repisa limpia de apps fijadas y widgets."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает значки Finder и Корзины, оставляя в Dock только закреплённые приложения и виджеты."
          }
        }
      }
    },
    "Hides recent / unpinned running apps even when \"Show Running Apps\" is on. Useful when you want a stable dock layout that doesn't shift as apps launch." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрывает недавно открытые и незакреплённые запущенные приложения, даже если включён параметр «Показывать запущенные приложения». Удобно, если вы хотите, чтобы состав Dock не менялся при запуске приложений."
          }
        }
      }
    },
    "High %lld°" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максимум %lld°"
          }
        }
      }
    },
    "Hold on one selection to preview that window behind the switcher without changing focus until you release the shortcut." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén una selección para previsualizar esa ventana detrás del conmutador sin cambiar el foco hasta que sueltes el atajo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Остановитесь на выбранном окне, чтобы увидеть его за переключателем. Фокус не изменится, пока вы не отпустите сочетание клавиш."
          }
        }
      }
    },
    "Home" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Домой"
          }
        }
      }
    },
    "Horizontal gap between icons at the reference height. Lower values pack icons tighter, higher values spread them out." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расстояние по горизонтали между значками при эталонной высоте. Чем меньше значение, тем плотнее расположены значки."
