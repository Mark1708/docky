    "theme.snow-leopard.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A faithful Snow Leopard recreation: classic chrome with sprite background, custom dividers, and a curated set of per-app icons from the Leopard Snow pack."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точное воссоздание Snow Leopard: классическое оформление с фоновым спрайтом, пользовательскими разделителями и подобранным набором значков приложений из комплекта Leopard Snow."
          }
        }
      }
    },
    "theme.windows.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flat, dark Windows 10 taskbar look: sharp-cornered chrome with a near-opaque charcoal fill, no glass, tight tile spacing, and a thin accent-blue running-app pill at the bottom edge."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плоское тёмное оформление панели задач Windows 10: прямые углы, почти непрозрачная графитовая заливка без эффекта стекла, плотное расположение плиток и тонкий синий индикатор запущенного приложения у нижнего края."
          }
        }
      }
    },
    "Themes" : {
      "extractionState" : "manual",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
