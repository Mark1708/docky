      }
    },
    "Treats the dock as a shelf of pinned apps and widgets. Use the toggles to pick which fixtures, Finder, Trash, or both, disappear while shelve mode is on." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock используется как полка для закреплённых приложений и виджетов. Выберите, какие постоянные элементы — Finder, Корзина или оба — будут скрыты в режиме полки."
          }
        }
      }
    },
